{% extends 'base.html.twig' %}

{% block button %}
{% if session['auth'] %}
    <h2>{{session['login']}}</h2>
    <a href="#">Se deconnecter</a>
{% else %}
    <a href="/login">Se connecter</a>
    <a href="/sign_up">S'inscrire</a>
{% endif %}
{% endblock %}

{% block body %}
{% if session['auth'] %}
    <p>Vous êtes connecté</p>
{% else %}
    <p>Vous n'êtes pas connecté</p>
{% endif %}
{% endblock %}